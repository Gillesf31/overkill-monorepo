{
  "name": "todo-list-data-access",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/todo-list/data-access/src",
  "prefix": "overkill-monorepo",
  "projectType": "library",
  "tags": ["scope:todo-list", "type:data-access"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/todo-list/data-access/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/todo-list/data-access/**/*.ts", "libs/todo-list/data-access/**/*.html"]
      }
    }
  }
}
